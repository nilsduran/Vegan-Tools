# ==========================================
# Vegan Tools — Variables d'Entorn (.env)
# ==========================================

# ------------------------------------------
# Frontend (apps/web)
# Configurar a Render (Static Site) o .env local
# ------------------------------------------
VITE_API_URL=https://vegan-tools-api.onrender.com
VITE_SUPABASE_URL=https://ictqmbgzaxmixhkazdce.supabase.co
VITE_SUPABASE_ANON_KEY=

# Fons del mapa (opcionals; sense elles el mapa usa OpenFreeMap). Són visibles al navegador:
# restringeix-les pel domini (HTTP referrer) des del panell de cada proveïdor.
# VITE_CARTO_API_KEY=
# VITE_GEOAPIFY_API_KEY=


# ------------------------------------------
# Backend (apps/api)
# Configurar a Render (Web Service) o .env local
# ------------------------------------------
PORT=3000
WEB_ORIGIN=http://localhost:5173
GEMINI_API_KEY=
SUPABASE_URL=https://ictqmbgzaxmixhkazdce.supabase.co
SUPABASE_SECRET_KEY=
GEOAPIFY_API_KEY=

# Només per a desenvolupament local SENSE Supabase: accepta tokens d'usuari sense
# verificar-ne la signatura. Mai a producció (amb Supabase configurat s'ignora).
# AUTH_ALLOW_UNVERIFIED_TOKENS=true
